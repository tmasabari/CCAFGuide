{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeReviewResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "severity", "category", "finding", "evidence", "confidence"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["REPORT", "SKIP"]
    },
    "severity": {
      "type": ["string", "null"],
      "enum": ["critical", "high", "medium", "low", null]
    },
    "category": {
      "type": ["string", "null"],
      "enum": ["security", "correctness", "reliability", "maintainability", "other", null]
    },
    "category_detail": {
      "type": ["string", "null"]
    },
    "finding": {
      "type": ["string", "null"]
    },
    "evidence": {
      "type": ["string", "null"]
    },
    "suggested_fix": {
      "type": ["string", "null"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "decision": { "const": "REPORT" } },
        "required": ["decision"]
      },
      "then": {
        "required": ["severity", "category", "finding", "evidence"]
      }
    }
  ]
}
